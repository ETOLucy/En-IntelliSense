{
  "outputDirectory": "public",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 120
    },
    "overseasRegions": [
      "ap-bangkok"
    ]
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/*.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/*.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "caches": [
    {
      "source": "/*.js",
      "cacheTtl": 3600
    },
    {
      "source": "/*.css",
      "cacheTtl": 3600
    }
  ]
}
