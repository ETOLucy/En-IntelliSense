{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "en-intellisense",
  "main": "worker.js",
  "compatibility_date": "2026-07-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
    "OPENAI_AUTOCOMPLETE_MODEL": "gpt-4.1-mini"
  }
}
