# Required only for AI features. Use credentials from your own model provider.
# Never commit a populated .env file or share its contents in an issue.
OPENAI_API_KEY=your_own_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_AUTOCOMPLETE_MODEL=gpt-4.1-mini
# Optional for an OpenAI-compatible provider. The server appends /v1/responses.
OPENAI_BASE_URL=https://api.openai.com
# Use chat for broad OpenAI-compatible provider support; set responses when required.
OPENAI_API_STYLE=chat
ENWRITE_PORT=8000

# The Windows EXE also reads .env beside the EXE or from:
# %APPDATA%\En-IntelliSense\.env
