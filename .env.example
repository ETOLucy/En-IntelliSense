# Required only for AI features. Use credentials from your own model provider.
# Never commit a populated .env file or share its contents in an issue.
MODEL_API_KEY=your_own_api_key_here
MODEL_ID=example-model
# Optional future optimization. Leave unset to use MODEL_ID for every AI feature.
# MODEL_AUTOCOMPLETE_ID=example-fast-model
# Use an endpoint that implements Chat Completions or Responses.
MODEL_BASE_URL=https://api.example.com
# Use chat for Chat Completions; set responses when required by your service.
MODEL_API_STYLE=chat
ENWRITE_PORT=8000

# The Windows desktop app normally saves these values through Model settings.
# This file remains available for development and advanced portable use.
